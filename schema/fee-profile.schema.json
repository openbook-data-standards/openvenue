{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvenue.dev/schema/fee-profile.schema.json",
  "title": "FeeProfile",
  "description": "A venue's fee schedule. See spec/openvenue.md section 4.4.",
  "type": "object",
  "properties": {
    "taker_fee_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0
    },
    "network_fee_usd": {
      "type": "number",
      "minimum": 0,
      "default": 0
    }
  },
  "additionalProperties": false
}
