{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvenue.dev/schema/quote-request.schema.json",
  "title": "QuoteRequest",
  "description": "Stateless quote input: the caller supplies every book and fee profile with each request. See spec/openvenue.md section 4.5.",
  "type": "object",
  "required": ["canonicalMarketId", "side", "budgetUsd"],
  "properties": {
    "canonicalMarketId": { "type": "string", "minLength": 1 },
    "side": { "enum": ["home", "away", "draw", "over", "under", "yes", "no"] },
    "budgetUsd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 50000
    },
    "builderFeeBps": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "default": 0
    },
    "books": {
      "type": "array",
      "items": { "$ref": "orderbook.schema.json" },
      "default": []
    },
    "feeProfiles": {
      "type": "object",
      "description": "Map of opaque venue key to FeeProfile.",
      "additionalProperties": { "$ref": "fee-profile.schema.json" },
      "default": {}
    }
  },
  "additionalProperties": false
}
