{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvenue.dev/schema/market-equivalence.schema.json",
  "title": "MarketEquivalence",
  "description": "One canonical market and each venue's own reference for it. See spec/openvenue.md section 4.10.",
  "type": "object",
  "required": ["canonical_id", "sport", "league", "start_time", "venue_market_ids"],
  "properties": {
    "canonical_id": { "type": "string" },
    "sport": { "type": "string" },
    "league": { "type": "string" },
    "start_time": { "type": "string", "format": "date-time" },
    "venue_market_ids": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
