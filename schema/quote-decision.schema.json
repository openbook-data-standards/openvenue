{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvenue.dev/schema/quote-decision.schema.json",
  "title": "QuoteDecision",
  "description": "The routing core's answer: best route, per-venue quotes, optional split plan, expiry. See spec/openvenue.md section 4.7.",
  "type": "object",
  "required": [
    "canonical_market_id",
    "side",
    "requested_budget_usd",
    "best_route",
    "all_in_price",
    "total_contracts_yielded",
    "venue_quotes",
    "expires_at"
  ],
  "properties": {
    "canonical_market_id": {
      "type": "string"
    },
    "side": {
      "type": "string"
    },
    "requested_budget_usd": {
      "type": "number"
    },
    "best_route": {
      "type": "string"
    },
    "all_in_price": {
      "type": "number"
    },
    "total_contracts_yielded": {
      "type": "number"
    },
    "venue_quotes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "venue-quote.schema.json"
      }
    },
    "split_plan": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
