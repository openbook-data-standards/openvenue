{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvenue.dev/schema/orderbook.schema.json",
  "title": "OrderBook",
  "description": "A venue's bids and asks for one canonical market at one instant. See spec/openvenue.md section 4.3.",
  "type": "object",
  "required": ["venue", "bids", "asks", "timestamp_ms"],
  "properties": {
    "venue": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque venue key."
    },
    "bids": {
      "type": "array",
      "items": { "$ref": "#/definitions/level" }
    },
    "asks": {
      "type": "array",
      "items": { "$ref": "#/definitions/level" }
    },
    "timestamp_ms": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "Epoch milliseconds; rejected if more than 60 s in the future."
    }
  },
  "definitions": {
    "level": {
      "type": "object",
      "required": ["price", "size"],
      "properties": {
        "price": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "size": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
